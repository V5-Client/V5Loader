{
    "schemaVersion": 1,
    "id": "ctjs",
    "name": "V5",
    "version": "$version",
    "description": "A ChatTriggers fork that supports additional features.",
    "authors": ["Zurviq, rdbt, EpsilonPhoenix"],
    "contributors": ["Oblongboot", "Nathan", "IcyHenryT"],
    "icon": "assets/v5/icon.png",
    "license": ["GPL-3.0."],
    "contact": {
        "homepage": "https://rdbt.top/",
        "sources": "https://discord.gg/RvQJq7vE3a",
        "issues": "https://discord.gg/RvQJq7vE3a"
    },
    "environment": "client",
    "entrypoints": {
        "preLaunch": [
            {
                "value": "com.v5.loader.V5PreLaunch",
                "adapter": "kotlin"
            },
            "com.chattriggers.ctjs.internal.launch.CTJSPreLaunch"
        ],
        "client": [
            "com.chattriggers.ctjs.CTJS",
            "com.chattriggers.ctjs.api.world.pathfinding.Swift"
        ]
    },
    "mixins": ["ctjs.mixins.json", "v5.mixins.json"],
    "depends": {
        "minecraft": "=$minecraft_version",
        "fabricloader": ">=$loader_version",
        "fabric-api": ">=$fabric_api_version",
        "fabric-language-kotlin": ">=$fabric_kotlin_version",
        "hypixel-mod-api": ">=1.0.2"
    },
    "breaks": {
        "stfu": "*",
        "nvidium": "*"
    },
    "custom": {
        "modmenu": {
            "links": {
                "modmenu.discord": "https://discord.gg/RvQJq7vE3a"
            }
        }
    },
    "accessWidener": "ctjs.accesswidener"
}
